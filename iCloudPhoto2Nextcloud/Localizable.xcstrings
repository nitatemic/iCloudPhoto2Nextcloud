{
  "sourceLanguage" : "fr",
  "strings" : {
    "%@ : %@" : {
      "comment" : "Accessibility label for a stat card that combines the title and count of the stat. The first argument is the string “Photothèque”, the string “Synchronisés” or the string “En attente”. The second argument is the string “%arg”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ : %2$@"
          }
        }
      }
    },
    "%@ : %lld" : {
