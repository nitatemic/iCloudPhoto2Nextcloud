<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Background / Menu Bar Agent Mode (No Dock Icon) -->
    <key>LSUIElement</key>
    <true/>
    
    <!-- PhotoKit Usage Permission -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Permission requise pour accéder à votre photothèque iCloud afin de synchroniser vos photos et vidéos avec votre serveur Nextcloud.</string>
    
    <!-- Network Transport Security (Supports self-hosted Nextcloud instances) -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
