<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- La sandbox est désactivée : elle empêcherait l'auto-update de remplacer
         l'application dans /Applications. L'accès Photos reste soumis à
         l'autorisation système (TCC) via NSPhotoLibraryUsageDescription. -->
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>
</dict>
</plist>
